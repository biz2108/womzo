# Exclude everything by default
**

# Files required to build the application
!Dockerfile
!.dockerignore
!app.py
!VERSION
!requirements.txt
!LICENSE
!THIRD_PARTY_NOTICES.md

# Application templates and static assets
!templates/
!templates/**
!static/
!static/**

# Additional protection within permitted directories
**/.env
**/.env.*
**/__pycache__/
**/*.pyc
**/*.bak
**/*.bak.*
**/*.before-*
**/*.sqlite3
**/*.sqlite3-*
**/*.db
**/*.db-*
