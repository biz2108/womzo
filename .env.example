
# SJB's World Webcams configuration
# Copy this file to .env and replace the placeholder secrets.

# Administrator password (minimum 16 characters)
ADMIN_PASSWORD=replace_with_random_32_character_password

# Flask signing key (minimum 32 characters)
SECRET_KEY=replace_with_random_64_character_secret

# Docker user and group IDs
PUID=1000
PGID=1000

# Use true when accessing the application through HTTPS.
# For trusted local-only HTTP installations, use false.
# Never expose HTTP administration directly to the internet.
SESSION_COOKIE_SECURE=true

# Host IP address on which to publish the application.
# Localhost is the secure default.
# Use your server's LAN IP if your reverse proxy runs
# on another machine.
BIND_ADDRESS=127.0.0.1
